# =================================
# APPLICATION CONFIGURATION
# =================================
NODE_ENV=development
APP_NAME=GovBid Pro
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# =================================
# DATABASE CONFIGURATION
# =================================
# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/govbid_pro?schema=public"
POSTGRES_USER=govbid_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=govbid_pro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB (for unstructured data)
MONGODB_URI=mongodb://localhost:27017/govbid_pro

# Redis (for caching and queues)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# =================================
# AUTHENTICATION & SECURITY
# =================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# Session
SESSION_SECRET=your_session_secret_key

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key

# CORS
CORS_ORIGIN=http://localhost:5173

# =================================
# AI SERVICES
# =================================
# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# OpenAI (Fallback)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX=govbid-contracts

# =================================
# GOVERNMENT APIs
# =================================
# SAM.gov
SAM_GOV_API_KEY=your_sam_gov_api_key
SAM_GOV_BASE_URL=https://api.sam.gov

# USASpending.gov
USASPENDING_API_KEY=your_usaspending_api_key
USASPENDING_BASE_URL=https://api.usaspending.gov

# =================================
# FILE STORAGE
# =================================
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=govbid-pro-uploads

# Local Storage (Development)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# =================================
# EMAIL SERVICE
# =================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# SendGrid (Alternative)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@govbidpro.com
SENDGRID_FROM_NAME=GovBid Pro

# Email Templates
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# =================================
# PAYMENT PROCESSING
# =================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Subscription Plans
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PROFESSIONAL_PRICE_ID=price_professional_monthly
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# =================================
# EXTERNAL INTEGRATIONS
# =================================
# Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Microsoft Outlook
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Salesforce
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_REDIRECT_URI=http://localhost:3000/auth/salesforce/callback

# QuickBooks
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/auth/quickbooks/callback

# =================================
# MONITORING & ANALYTICS
# =================================
# Sentry
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development

# LogRocket
LOGROCKET_APP_ID=your_logrocket_app_id

# Mixpanel
MIXPANEL_TOKEN=your_mixpanel_token

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# =================================
# WEB SCRAPING
# =================================
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000
SCRAPER_RATE_LIMIT=10
SCRAPER_CONCURRENT_JOBS=5

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# WEBSOCKETS
# =================================
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/ws

# =================================
# JOB QUEUE
# =================================
BULL_REDIS_URL=redis://localhost:6379
BULL_CONCURRENCY=5

# =================================
# FEATURE FLAGS
# =================================
ENABLE_CONTRACT_SCRAPING=true
ENABLE_AI_BID_COACH=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_COMPETITIVE_ANALYSIS=true

# =================================
# DEVELOPMENT TOOLS
# =================================
LOG_LEVEL=debug
ENABLE_QUERY_LOGGING=true
ENABLE_API_DOCS=true
ENABLE_SEED_DATA=true
